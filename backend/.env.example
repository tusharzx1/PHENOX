PORT=3001
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/phenox?retryWrites=true&w=majority
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
ADMIN_AUTH_TOKEN=<set_a_strong_random_bearer_token>
ALLOW_INSECURE_DEMO_AUTH=false
NODE_ENV=development

# Production blockchain indexer config
MONAD_RPC_URL=https://rpc.ankr.com/monad_testnet
MONAD_NETWORK=monad-testnet
MONAD_EXPECTED_CHAIN_ID=10143
MONAD_TESTNET_EXPLORER_TX_BASE=https://testnet.monadvision.com/tx/
GOLD_TOKEN_ADDRESS=0xYourGoldTokenAddress
BATCH_MANAGER_ADDRESS=0xYourBatchManagerAddress
DATABASE_URL=postgresql://username:password@localhost:5432/phenox
INDEXER_START_BLOCK=0
INDEXER_CHUNK_SIZE=1500
INDEXER_SYNC_INTERVAL_MS=60000
BATCH_REFRESH_INTERVAL_MS=600000
CORS_ORIGIN=*

# Monad anchoring config for /api/blockchain/admin/push
# Docs: https://docs.monad.xyz/guides/add-monad-to-wallet/testnet
# Testnet was reset from genesis on 2025-12-16, redeploy contracts after reset.
MONAD_ANCHOR_CHAIN_NAME=monad-testnet
MONAD_ANCHOR_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_ANCHOR_CHAIN_ID=10143
MONAD_ANCHOR_EXPLORER_TX_BASE=https://testnet.monadvision.com/tx/
MONAD_ANCHOR_PRIVATE_KEY=0x<backend_wallet_private_key>
MONAD_ANCHOR_REGISTRY_CONTRACT=0x<deployed_registry_contract_address>
MONAD_ANCHOR_REGISTRY_METHOD=registerBatch
MONAD_ANCHOR_CONFIRMATIONS=1
MONAD_ANCHOR_STRICT_MODE=false

# Monad gas model: sender is charged using gasLimit on Monad.
# Docs: https://docs.monad.xyz/developer-essentials/gas-pricing
MONAD_ANCHOR_GAS_LIMIT=250000
MONAD_ANCHOR_MAX_FEE_PER_GAS_GWEI=100
MONAD_ANCHOR_MAX_PRIORITY_FEE_PER_GAS_GWEI=2

# Backward compatibility (legacy names still supported):
# L1_RPC_URL, L1_PRIVATE_KEY, L1_REGISTRY_CONTRACT, L1_REGISTRY_METHOD,
# L1_CONFIRMATIONS, L1_STRICT_MODE, L1_CHAIN_NAME, L1_GAS_LIMIT,
# L1_MAX_FEE_PER_GAS_GWEI, L1_MAX_PRIORITY_FEE_PER_GAS_GWEI

# Production security:
# - keep ALLOW_INSECURE_DEMO_AUTH=false
# - set ADMIN_AUTH_TOKEN (or CLERK_SECRET_KEY with bearer auth)
